# TokYard alpha — copy to .env and set a strong owner password.
# Generate one with: openssl rand -base64 24
INITIAL_PASSWORD=
# Leave empty to generate a persistent random signing key in DATA_DIR/jwt-secret.
JWT_SECRET=
DATA_DIR=./.tokyard
PORT=20120
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
ENABLE_REQUEST_LOGS=false
AUTH_COOKIE_SECURE=false
# Set true when serving behind HTTPS.
# AUTH_COOKIE_SECURE=true
# Optional external donation page. Must use HTTPS; no default recipient.
TOKYARD_DONATE_URL=
# Optional provider egress proxy.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
